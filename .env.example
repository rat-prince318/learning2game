# Local offline walkthrough for teammates. Actual secrets belong in .env only.
EDUGAME_DEMO=1
EDUGAME_MAX_UPLOAD_BYTES=10485760
EDUGAME_SERVICE_TIMEOUT=60
EDUGAME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Integrated mode: set EDUGAME_DEMO=0 and the actual importable adapter.
# EDUGAME_SERVICE_FACTORY=your_package.integration:build_services
# EDUGAME_DATA_DIR=absolute/path/to/a/private/data/directory
