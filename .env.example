# With a Beijing Model Studio key, the application automatically uses live models.
# Leave mode unset for automatic selection; uncomment the next line to force offline operation.
# EDUGAME_MODE=offline
EDUGAME_MAX_UPLOAD_BYTES=10485760
# Stage deadlines default to 60 seconds offline and 400 seconds for live tool loops.
# EDUGAME_SERVICE_TIMEOUT=400
EDUGAME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# One Beijing Model Studio key enables both live basketball and RPG lessons.
# deepseek-v4.1-flash-1017 writes and reviews questions. qwen3-vl-plus reads diagrams and scans.
# Install Node.js 22+ on the API host to check formulas with the game's KaTeX build.
DASHSCOPE_API_KEY=
# The following separate providers are optional alternatives.
# B: an OpenAI-compatible endpoint, a text model and an image-capable model.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_TEXT_MODEL=
# LLM_VISION_MODEL=
# LLM_TIMEOUT=75
# A: an OpenAI-compatible endpoint with function calling and JSON output.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# AGENT_TIMEOUT_SECONDS=75
# Optional alternative integration factory for other teams.
# EDUGAME_SERVICE_FACTORY=your_package.integration:build_services
# EDUGAME_DATA_DIR=absolute/path/to/a/private/data/directory
