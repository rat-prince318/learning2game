    "PlayerView": {
      "additionalProperties": false,
      "properties": {
        "hp": {
          "minimum": 0,
          "title": "Hp",
          "type": "integer"
        },
        "max_hp": {
          "minimum": 0,
          "title": "Max Hp",
          "type": "integer"
        },
        "level": {
          "minimum": 0,
          "title": "Level",
          "type": "integer"
        },
        "xp": {
          "minimum": 0,
          "title": "Xp",
          "type": "integer"
        },
        "xp_to_next_level": {
          "minimum": 0,
          "title": "Xp To Next Level",
          "type": "integer"
        },
        "attack": {
          "minimum": 0,
          "title": "Attack",
          "type": "integer"
        },
        "equipped_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
