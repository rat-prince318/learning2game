{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BattleConcept": {
      "additionalProperties": false,
      "properties": {
        "knowledge_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Knowledge Id",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Scene Id",
          "type": "string"
        },
        "term": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Term",
          "type": "string"
        },
        "explanation": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "combat_attempts": {
          "minimum": 0,
          "title": "Combat Attempts",
          "type": "integer"
        },
        "combat_correct": {
          "minimum": 0,
          "title": "Combat Correct",
          "type": "integer"
        },
        "combat_mistakes": {
          "minimum": 0,
          "title": "Combat Mistakes",
          "type": "integer"
        },
        "first_attempt_correct": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Attempt Correct"
        },
        "hints": {
          "minimum": 0,
          "title": "Hints",
          "type": "integer"
        },
        "review_attempts": {
          "minimum": 0,
          "title": "Review Attempts",
          "type": "integer"
        },
        "review_correct": {
          "minimum": 0,
          "title": "Review Correct",
          "type": "integer"
        },
        "review_hints": {
          "minimum": 0,
          "title": "Review Hints",
          "type": "integer"
        }
      },
      "required": [
        "knowledge_id",
        "scene_id",
        "term",
        "explanation",
        "source_ref",
        "combat_attempts",
        "combat_correct",
        "combat_mistakes",
        "first_attempt_correct",
        "hints",
        "review_attempts",
        "review_correct",
        "review_hints"
      ],
      "title": "BattleConcept",
      "type": "object"
    },
    "BountySeal": {
      "additionalProperties": false,
      "properties": {
        "region_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Region Id",
          "type": "string"
        },
        "region_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Region Name",
          "type": "string"
        },
        "boss_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Boss Id",
          "type": "string"
        }
      },
      "required": [
        "region_id",
        "region_name",
        "boss_id"
      ],
      "title": "BountySeal",
      "type": "object"
    },
    "Gear": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tier": {
          "minimum": 0,
          "title": "Tier",
          "type": "integer"
        },
        "attack_bonus": {
          "default": 0,
          "minimum": 0,
          "title": "Attack Bonus",
          "type": "integer"
        },
        "slot": {
          "default": "weapon",
          "enum": [
            "weapon",
            "armor",
            "accessory"
          ],
          "title": "Slot",
          "type": "string"
        },
        "class_id": {
          "anyOf": [
            {
              "enum": [
                "arcanist",
                "vanguard",
                "ranger"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "arcanist",
          "title": "Class Id"
        },
        "hp_bonus": {
          "default": 0,
          "minimum": 0,
          "title": "Hp Bonus",
          "type": "integer"
        },
        "defense_bonus": {
          "default": 0,
          "minimum": 0,
          "title": "Defense Bonus",
          "type": "integer"
        },
        "critical_interval_reduction": {
          "default": 0,
          "minimum": 0,
          "title": "Critical Interval Reduction",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "tier"
      ],
      "title": "Gear",
      "type": "object"
    },
    "HeldRelic": {
      "additionalProperties": false,
      "properties": {
        "relic": {
          "$ref": "#/$defs/RelicSpec"
        },
        "stacks": {
          "minimum": 0,
          "title": "Stacks",
          "type": "integer"
        }
      },
      "required": [
        "relic",
        "stacks"
      ],
      "title": "HeldRelic",
      "type": "object"
    },
    "HeroStats": {
      "additionalProperties": false,
      "properties": {
        "max_hp": {
          "minimum": 0,
          "title": "Max Hp",
          "type": "integer"
        },
        "attack": {
          "minimum": 0,
          "title": "Attack",
          "type": "integer"
        },
        "defense": {
          "minimum": 0,
          "title": "Defense",
          "type": "integer"
        },
        "crit_every": {
          "minimum": 0,
          "title": "Crit Every",
          "type": "integer"
        },
        "focus_max": {
          "minimum": 0,
          "title": "Focus Max",
          "type": "integer"
        },
        "burst_percent": {
          "minimum": 0,
          "title": "Burst Percent",
          "type": "integer"
        }
      },
      "required": [
        "max_hp",
        "attack",
        "defense",
        "crit_every",
        "focus_max",
        "burst_percent"
      ],
      "title": "HeroStats",
      "type": "object"
    },
    "Loadout": {
      "additionalProperties": false,
      "properties": {
        "weapon": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
