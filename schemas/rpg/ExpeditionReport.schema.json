        "hp",
        "max_hp",
        "level",
        "xp",
        "xp_to_next_level",
        "attack",
        "equipped_id",
        "inventory",
        "combo",
        "focus",
        "focus_max",
        "burst_ready",
        "loadout"
      ],
      "title": "PlayerView",
      "type": "object"
    },
    "RelicBonuses": {
      "additionalProperties": false,
