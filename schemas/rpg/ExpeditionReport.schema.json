          "type": "integer"
        },
        "focus": {
          "minimum": 0,
          "title": "Focus",
          "type": "integer"
        },
        "focus_max": {
          "minimum": 0,
          "title": "Focus Max",
          "type": "integer"
        },
        "burst_ready": {
          "title": "Burst Ready",
          "type": "boolean"
        },
        "hero_class": {
          "default": "arcanist",
          "enum": [
            "arcanist",
            "vanguard",
            "ranger"
          ],
          "title": "Hero Class",
          "type": "string"
        },
        "kit": {
          "anyOf": [
            {
              "enum": [
                "trail",
                "ward"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kit"
        },
        "loadout": {
          "$ref": "#/$defs/Loadout"
        },
        "stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeroStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null
