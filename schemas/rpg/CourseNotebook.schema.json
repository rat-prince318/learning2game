{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CourseNote": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "body": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "region_index": {
          "minimum": 0,
          "title": "Region Index",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "title",
        "body",
        "source_ref",
        "region_index"
      ],
      "title": "CourseNote",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "notes": {
      "items": {
        "$ref": "#/$defs/CourseNote"
      },
      "title": "Notes",
      "type": "array"
    },
    "relevant_note_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "title": "Relevant Note Ids",
      "type": "array"
    },
    "spot_note_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "title": "Spot Note Ids",
      "type": "array"
    },
    "spot_total": {
      "minimum": 0,
      "title": "Spot Total",
      "type": "integer"
    }
  },
  "required": [
    "notes",
    "relevant_note_ids",
    "spot_note_ids",
    "spot_total"
  ],
  "title": "CourseNotebook",
  "type": "object"
}
