      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "advance_exploration",
          "title": "Action",
          "type": "string"
        },
        "event_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Event Id",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        }
      },
      "required": [
        "action",
        "event_id",
        "expected_revision"
      ],
      "title": "AdvanceExploration",
      "type": "object"
    },
