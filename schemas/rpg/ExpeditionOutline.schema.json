{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "OutlineVolume": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "terms": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Terms",
          "type": "array"
        },
        "plan_request": {
          "$ref": "#/$defs/PlanRequest"
        }
      },
      "required": [
        "number",
        "terms",
        "plan_request"
      ],
      "title": "OutlineVolume",
      "type": "object"
    },
    "PlanRequest": {
      "additionalProperties": false,
      "properties": {
        "material_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
          "title": "Material Id",
          "type": "string"
        },
        "preferences": {
          "$ref": "#/$defs/RPGPreferences"
        }
      },
      "required": [
        "material_id"
      ],
      "title": "PlanRequest",
      "type": "object"
    },
    "RPGPreferences": {
      "additionalProperties": false,
      "properties": {
        "question_language": {
          "anyOf": [
            {
              "enum": [
                "zh",
                "en"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Language"
        },
        "goal": {
          "default": "review",
          "enum": [
            "preview",
            "review",
            "classroom",
            "recognize",
            "distinguish"
          ],
          "title": "Goal",
          "type": "string"
        },
        "learner_level": {
          "default": "beginner",
          "enum": [
            "beginner",
            "familiar"
          ],
          "title": "Learner Level",
          "type": "string"
        },
        "difficulty": {
          "default": "medium",
          "enum": [
            "easy",
            "medium",
            "hard"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "challenge_count": {
          "default": 6,
          "maximum": 8,
          "minimum": 1,
          "title": "Challenge Count",
          "type": "integer"
        },
        "scene_count": {
          "default": 3,
          "maximum": 4,
          "minimum": 1,
          "title": "Scene Count",
          "type": "integer"
        },
        "theme": {
          "default": "laboratory",
          "enum": [
            "campus",
            "laboratory",
            "fantasy"
          ],
          "title": "Theme",
          "type": "string"
        },
        "selected_knowledge_ids": {
          "anyOf": [
            {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
                "type": "string"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Knowledge Ids"
        }
      },
      "title": "RPGPreferences",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "concept_count": {
      "minimum": 0,
      "title": "Concept Count",
      "type": "integer"
    },
    "scene_count": {
      "minimum": 0,
      "title": "Scene Count",
      "type": "integer"
    },
    "volumes": {
      "items": {
        "$ref": "#/$defs/OutlineVolume"
      },
      "title": "Volumes",
      "type": "array"
    }
  },
  "required": [
    "concept_count",
    "scene_count",
    "volumes"
  ],
  "title": "ExpeditionOutline",
  "type": "object"
}
